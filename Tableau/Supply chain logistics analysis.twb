            <column caption='Shipments' datatype='string' name='[ASN/DN]' role='dimension' type='nominal' />
            <column caption='Shipment size quartile' datatype='string' name='[Calculation_1299851478961131520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Total shipment quantity] &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.25) } THEN &quot;Q1 - Smallest&quot;&#13;&#10;ELSEIF [Total shipment quantity] &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.50) } THEN &quot;Q2&quot;&#13;&#10;ELSEIF [Total shipment quantity] &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.75) } THEN &quot;Q3&quot;&#13;&#10;ELSE &quot;Q4 - Largest&quot;&#13;&#10;END' />
            </column>
            <column caption='Freight cost per unit' datatype='real' name='[Calculation_1299851478965055489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Total shipment quantity] &gt; 0&#13;&#10;THEN [Freight cost] / [Total shipment quantity]&#13;&#10;END' />
            </column>
            <column caption='Freight availability' datatype='string' name='[Calculation_2015642344553193474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Freight cost]) THEN &quot;Blank&quot;&#13;&#10;ELSE &quot;Available&quot;&#13;&#10;END' />
