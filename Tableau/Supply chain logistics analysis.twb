      <column caption='Shipments' datatype='string' name='[ASN/DN]' role='dimension' type='nominal' />
      <column caption='operation priority index' datatype='real' name='[Calculation_0567113667674112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    0.50 *&#13;&#10;    (&#13;&#10;        ([Calculation_234187215722569728]&#13;&#10;        - WINDOW_MIN([Calculation_234187215722569728]))&#13;&#10;        /&#13;&#10;        (WINDOW_MAX([Calculation_234187215722569728])&#13;&#10;        - WINDOW_MIN([Calculation_234187215722569728]))&#13;&#10;    )&#13;&#10;    +&#13;&#10;    0.30 *&#13;&#10;    (&#13;&#10;        (AVG([Calculation_1299851478965055489])&#13;&#10;        - WINDOW_MIN(AVG([Calculation_1299851478965055489])))&#13;&#10;        /&#13;&#10;        (WINDOW_MAX(AVG([Calculation_1299851478965055489]))&#13;&#10;        - WINDOW_MIN(AVG([Calculation_1299851478965055489])))&#13;&#10;    )&#13;&#10;    +&#13;&#10;    0.20 *&#13;&#10;    (&#13;&#10;        (COUNT([ASN/DN])&#13;&#10;        - WINDOW_MIN(COUNT([ASN/DN])))&#13;&#10;        /&#13;&#10;        (WINDOW_MAX(COUNT([ASN/DN]))&#13;&#10;        - WINDOW_MIN(COUNT([ASN/DN])))&#13;&#10;    )&#13;&#10;) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='weighted freight cost per unit' datatype='real' name='[Calculation_0874702312812544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Freight cost]) / SUM([Total shipment quantity])' />
      </column>
      <column caption='Shipment size quartile' datatype='string' name='[Calculation_1299851478961131520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total shipment quantity] &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.25) } THEN &quot;Q1 - Smallest&quot;&#13;&#10;ELSEIF [Total shipment quantity] &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.50) } THEN &quot;Q2&quot;&#13;&#10;ELSEIF [Total shipment quantity] &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.75) } THEN &quot;Q3&quot;&#13;&#10;ELSE &quot;Q4 - Largest&quot;&#13;&#10;END' />
      </column>
      <column caption='Freight cost per unit' datatype='real' name='[Calculation_1299851478965055489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Total shipment quantity] &gt; 0&#13;&#10;THEN [Freight cost] / [Total shipment quantity]&#13;&#10;END' />
      </column>
      <column caption='Freight available' datatype='integer' name='[Calculation_2015642344548937728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([Freight cost]) THEN 1 ELSE 0 END' />
      </column>
      <column caption='Freight blank' datatype='integer' name='[Calculation_2015642344549511169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Freight cost]) THEN 1 ELSE 0 END' />
      </column>
      <column caption='Freight availability' datatype='string' name='[Calculation_2015642344553193474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Freight cost]) THEN &quot;Blank&quot;&#13;&#10;ELSE &quot;Available&quot;&#13;&#10;END' />
      </column>
      <column caption='Late delivery rate' datatype='real' name='[Calculation_234187215722569728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Delivery status] = &quot;Late&quot; THEN 1 ELSE 0 END)&#13;&#10;/&#13;&#10;COUNT([ASN/DN])' />
      </column>
      <column caption='Shipment count' datatype='integer' name='[Calculation_234187215727525889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ASN/DN])' />
      </column>
      <column caption='Country shipment count' datatype='integer' name='[Calculation_234187215797530628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Country] : COUNT([ASN/DN]) }' />
      </column>
      <column caption='ARV Shipment size quartile' datatype='string' name='[Calculation_517913995199770624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total shipment quantity]&#13;&#10;    &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.25) }&#13;&#10;THEN &quot;Q1 - Smallest&quot;&#13;&#10;&#13;&#10;ELSEIF [Total shipment quantity]&#13;&#10;    &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.50) }&#13;&#10;THEN &quot;Q2&quot;&#13;&#10;&#13;&#10;ELSEIF [Total shipment quantity]&#13;&#10;    &lt;= { FIXED : PERCENTILE([Total shipment quantity], 0.75) }&#13;&#10;THEN &quot;Q3&quot;&#13;&#10;&#13;&#10;ELSE &quot;Q4 - Largest&quot;&#13;&#10;END' />
      </column>
      <column caption='Late shipment count' datatype='integer' name='[Calculation_946037432252399616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Delivery status] = &quot;Late&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='None' datatype='integer' name='[Total shipment quantity (bin)]' role='dimension' type='quantitative'>
